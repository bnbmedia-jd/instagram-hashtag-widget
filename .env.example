# Long-lived access token for the IG Business/Creator account you added as a
# Tester on your Meta developer app (Standard Access — no App Review needed).
IG_ACCESS_TOKEN=

# The numeric Instagram Business Account ID that owns IG_ACCESS_TOKEN.
# Find it via: GET /me/accounts -> GET /{page-id}?fields=instagram_business_account
IG_BUSINESS_ACCOUNT_ID=

# The hashtag to track, without the #.
HASHTAG=yourhashtag

# Optional: comma-separated Business/Creator usernames to follow directly via
# business_discovery. Unlike hashtag search this has no ~24h window and reliably
# returns Reels. Requires instagram_manage_insights on IG_ACCESS_TOKEN.
IG_ACCOUNTS=bodynbrain.us

# Optional: drop posts published before this date (UTC). Applies to the whole
# feed, including posts already accumulated. Manual entries are exempt.
IG_SINCE=2026-08-25

# Set true when IG_ACCESS_TOKEN belongs to the account you want to feature.
# Its own media edge returns playable video URLs that business_discovery
# withholds, so Reels play inline instead of falling back to a still.
IG_INCLUDE_SELF=false

# Port for the local widget server.
PORT=3000
